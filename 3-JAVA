public class cal {
    
    static int count;
    int add(int a, int b)
    {
        count++;
        return a+b;
    }

    int add(double a, double b)
    {
        count++;
        return (int)(a + b) ;
    }





    public static void main(String[] args)
    {
            cal c = new cal();

            System.out.println("Addition of 2 and 3 is: " + c.add(2,3));

            System.out.println("Addition of 2.5 and 3.5 is: " + c.add(2.5,3.5));

            System.out.println("Total number of calls to add method is: " + cal.count);

    }
    
}
